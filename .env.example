# LibList Banking Frontend - Environment Variables Template
# Copy this to .env or configure these variables in the Vercel Dashboard

# Backend REST API URL (pointing to your deployed backend or localhost for dev)
# For Vercel production: https://your-backend-domain.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# Firebase Web App Credentials
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
